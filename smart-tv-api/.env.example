# Examples only. Never copy production .env, source files or databases into this repo.
# Docker: service alias on an existing, explicitly chosen development network.
LIBRETV_URL=http://libretv:8080
LIBRETV_PASSWORD=replace-with-development-libretv-password
SMART_TV_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
LIBRETV_NETWORK=libretv_default
SMART_TV_BIND_ADDRESS=127.0.0.1
SMART_TV_PORT=8081
# For npm dev/start outside Docker use a separately started LOCAL LibreTV instance,
# e.g. LIBRETV_URL=http://127.0.0.1:18080 (not container localhost).
HOST=127.0.0.1
PORT=8081
DATABASE_PATH=data/smart-tv.sqlite
UPSTREAM_TIMEOUT_MS=12000
OPERATION_TIMEOUT_MS=30000
UPSTREAM_CONCURRENCY=2
MAX_RESPONSE_BYTES=2097152
MAX_SOURCES=500
MAX_SEARCH_RESULTS=1000
MAX_ACTIVE_REQUESTS=8
FILTER_ADULT=true
LOG_LEVEL=info
